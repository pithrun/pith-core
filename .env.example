# Pith Configuration
# Copy this to .env and customize (or let install.sh generate it for you)

# API key for Pith server authentication (auto-generated by install.sh)
PITH_API_KEY=change-me-to-random-key
# Legacy alias (still supported): BRAIN_API_KEY

# Port for the Pith API (default: 8000)
# Note: this env var is NOT read by any code — port is hardcoded to 8000 in server.py
PITH_PORT=8000
